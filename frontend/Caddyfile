{
	# 前面還有一層反向代理（共用機器時）時，保留它傳來的 X-Forwarded-For，
	# 後端才拿得到 TradingView 的真實 IP（IP 白名單會用到）。只信任內網位址。
	servers {
		trusted_proxies static private_ranges
	}
}

# SITE_ADDRESS 設成你的網域（例如 bot.example.com）時，Caddy 會自動申請 HTTPS 憑證；
# 預設 :80 只適合本機或放在 ngrok / cloudflared 後面
{$SITE_ADDRESS::80} {
	encode gzip
	header {
		# 不准其他網站用 iframe 嵌入（避免點擊劫持，例如誘騙按下「緊急全部平倉」）
		# 只載入自己網域的程式；React 與圖表會設定行內 style，所以 style 需要 'unsafe-inline'
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://{host} ws://{host}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 只有經由 HTTPS 送到瀏覽器時才會生效
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# 限制請求大小：webhook 與登入不需登入就能呼叫，沒有上限的話一個超大請求就能吃光後端記憶體
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8000
	}
	handle /webhook/* {
		# TradingView 的訊號只有幾百 bytes
		request_body {
			max_size 64KB
		}
		reverse_proxy backend:8000
	}
	handle /ws {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		# 打包後的檔名含內容雜湊，內容變了檔名就會變：可以放心長期快取
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html 每次都要跟伺服器確認，部署後重新整理就會拿到新版（不用強制重新整理）
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
