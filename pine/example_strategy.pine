//@version=6
// TradeBot 範例策略：EMA 交叉 + ATR 停損
// 用法：加到圖表 → 建立警示（Alert）→ 條件選這個策略，並選「Order fills only」
//       → 通知分頁勾選 Webhook URL，填 https://你的網域/webhook/tradingview
//       → Message 貼上 README 裡的 JSON 模板（記得換成你自己的 secret）
strategy("TradeBot EMA Cross", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.04)

fastLen   = input.int(12, "快線 EMA")
slowLen   = input.int(26, "慢線 EMA")
atrLen    = input.int(14, "ATR 週期")
atrMult   = input.float(2.0, "ATR 停損倍數", step = 0.1)
allowShort = input.bool(true, "允許做空（現貨請關閉）")

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
atr  = ta.atr(atrLen)

plot(fast, "Fast EMA", color = color.new(color.blue, 0), linewidth = 2)
plot(slow, "Slow EMA", color = color.new(color.orange, 0), linewidth = 2)

longCond  = ta.crossover(fast, slow)
shortCond = ta.crossunder(fast, slow)

if longCond
    strategy.entry("L", strategy.long)
if shortCond
    if allowShort
        strategy.entry("S", strategy.short)
    else
        strategy.close("L", comment = "exit")

// ATR 追蹤停損：觸發時 TradingView 也會送出 Order fill 警示，後端會依 market_position=flat 平倉
if strategy.position_size > 0
    strategy.exit("L-SL", "L", stop = strategy.position_avg_price - atr * atrMult)
if strategy.position_size < 0
    strategy.exit("S-SL", "S", stop = strategy.position_avg_price + atr * atrMult)
