# Binance API（只開「讀取+交易」，不要開提領）
# TESTNET=true 時請到 https://demo.binance.com/en/my/settings/api-management 建立 Demo Trading 的 key
# （一組 key 同時適用現貨和合約；舊的 futures testnet 已停用）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = Binance Demo Trading（模擬帳戶）；false = 正式帳戶
TESTNET=true
# paper = 本地模擬撮合（不需 API key）；binance = 真的送單到 Binance（受 TESTNET 控制）
EXECUTION_MODE=paper
# paper 模式的起始 USDT（現貨、合約各一份）
PAPER_START_USDT=10000

# TradingView alert message 裡的 secret 必須跟這裡一致
WEBHOOK_SECRET=change-me

DATABASE_URL=sqlite+aiosqlite:///./tradebot.db

# Dashboard 登入
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
JWT_SECRET=change-me-too

# 選用：Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
